{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "target": "es2022",
        "lib": ["dom", "esnext"],
        "jsx": "react-jsx",
        "resolveJsonModule": true,
        "types": ["vite/client"],
        "paths": {
            "*": ["./src/*"]
        }
    },
    "include": ["src/**/*"],
    "exclude": [
        "src/**/__tests__/**",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/**/*.spec.ts",
        "src/**/*.spec.tsx",
        "src/setupTests.ts",
        "src/test-utils.tsx"
    ]
}
