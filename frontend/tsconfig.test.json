{
    "extends": "./tsconfig.app.json",
    "compilerOptions": {
        "composite": false,
        "types": ["vite/client", "node", "jest", "@testing-library/jest-dom"],
        "paths": {
            "*": ["./src/*"],
            "@test-utils": ["./src/test-utils.tsx"]
        },
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo"
    },
    "include": [
        "src/**/__tests__/**/*",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/**/*.spec.ts",
        "src/**/*.spec.tsx",
        "src/setupTests.ts",
        "src/test-utils.tsx"
    ],
    "exclude": []
}
