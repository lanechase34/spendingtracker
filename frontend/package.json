{
    "name": "spendingtracker",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "start": "vite",
        "build": "tsc -b && vite build",
        "serve": "vite preview",
        "test": "jest",
        "testcoverage": "jest --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:debug": "playwright test --debug",
        "test:e2e:report": "playwright show-report",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "audit:prod": "npm audit --omit=dev",
        "format": "prettier --config .prettierrc --write \"**/*.{ts,tsx}\" --log-level silent",
        "format:check": "prettier --config .prettierrc --check \"**/*.{ts,tsx}\"",
        "typecheck": "tsc -b --noEmit",
        "check": "npm run format && npm run lint && npm run typecheck && npm run knip",
        "knip": "knip"
    },
    "dependencies": {
        "@emotion/react": "11.14.0",
        "@emotion/styled": "11.14.1",
        "@fontsource/roboto": "5.3.0",
        "@mui/icons-material": "9.5.0",
        "@mui/lab": "9.0.0-beta.10",
        "@mui/material": "9.5.0",
        "@mui/x-data-grid": "9.16.0",
        "@mui/x-date-pickers": "9.16.0",
        "@stomp/stompjs": "7.5.0",
        "@tanstack/react-query": "5.104.5",
        "chart.js": "4.6.1",
        "chartjs-plugin-annotation": "3.1.0",
        "chartjs-plugin-datalabels": "2.2.0",
        "dayjs": "1.11.23",
        "react": "19.3.1",
        "react-chartjs-2": "5.3.1",
        "react-day-picker": "10.0.2",
        "react-dom": "19.3.1",
        "react-router-dom": "7.18.4",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "5.28.8",
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.64.1",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.8",
        "@tsconfig/node24": "^24.0.5",
        "@types/eslint-plugin-jsx-a11y": "6.10.1",
        "@types/jest": "30.0.0",
        "@types/node": "26.6.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "eslint": "10.13.0",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-jest": "^29.17.0",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-playwright": "2.12.1",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-simple-import-sort": "14.0.0",
        "identity-obj-proxy": "3.0.0",
        "jest": "30.5.2",
        "jest-environment-jsdom": "30.5.2",
        "jiti": "2.7.0",
        "knip": "6.43.0",
        "lefthook": "2.2.2",
        "npm-check-updates": "23.1.1",
        "prettier": "3.9.10",
        "rollup-plugin-visualizer": "7.1.1",
        "ts-jest": "29.4.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.0",
        "vite": "8.3.5"
    },
    "overrides": {
        "date-fns-jalali": "4.0.0-0"
    }
}
