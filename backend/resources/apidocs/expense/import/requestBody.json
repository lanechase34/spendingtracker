{
    "required": true,
    "content": {
        "multipart/form-data": {
            "schema": {
                "type": "object",
                "required": ["expenseFile"],
                "properties": {
                    "expenseFile": {
                        "type": "string",
                        "format": "binary",
                        "description": "Comma-delimited CSV. The header row must be exactly Date,Amount,Description, followed by at most 100 data rows."
                    }
                }
            }
        }
    }
}
