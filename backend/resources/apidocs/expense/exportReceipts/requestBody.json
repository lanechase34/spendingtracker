{
    "required": true,
    "content": {
        "application/json": {
            "schema": {
                "type": "object",
                "required": ["startDate", "endDate"],
                "properties": {
                    "startDate": { "type": "string", "format": "date", "example": "2025-01-01" },
                    "endDate": {
                        "type": "string",
                        "format": "date",
                        "example": "2025-12-31",
                        "description": "Must be on or after startDate and at most 365 days after it."
                    }
                }
            }
        }
    }
}
