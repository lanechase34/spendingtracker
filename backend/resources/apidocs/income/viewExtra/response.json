{
    "description": "Extra income entries, newest first.",
    "content": {
        "application/json": {
            "schema": {
                "type": "object",
                "properties": {
                    "error": { "type": "boolean", "example": false },
                    "data": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": { "type": "integer", "example": 12 },
                                "date": { "type": "string", "format": "date", "example": "2025-04-15" },
                                "amount": { "type": "number", "example": 250 },
                                "description": { "type": "string", "example": "Freelance project" }
                            }
                        }
                    }
                }
            }
        }
    }
}
