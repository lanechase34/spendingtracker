{
    "required": true,
    "content": {
        "application/json": {
            "schema": {
                "type": "object",
                "required": ["date", "pay"],
                "properties": {
                    "date": {
                        "type": "string",
                        "format": "date",
                        "example": "2025-04-01",
                        "description": "The month this pay record is for. Only the year and month are used. Must be after 2024-01-01 and before 2075-01-01."
                    },
                    "pay": { "type": "number", "minimum": 0, "maximum": 99999, "example": 4500 }
                }
            }
        }
    }
}
