{
    "required": true,
    "content": {
        "application/json": {
            "schema": {
                "type": "object",
                "required": ["date", "amount", "description"],
                "properties": {
                    "date": {
                        "type": "string",
                        "format": "date",
                        "example": "2025-04-15",
                        "description": "The date the extra income was received. Must be after 2024-01-01 and before 2075-01-01."
                    },
                    "amount": { "type": "number", "minimum": 0.01, "maximum": 99999, "example": 250 },
                    "description": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500,
                        "example": "Freelance project"
                    }
                }
            }
        }
    }
}
