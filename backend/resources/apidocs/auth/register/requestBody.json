{
    "required": true,
    "content": {
        "application/json": {
            "schema": {
                "type": "object",
                "required": ["email", "password", "salary", "monthlyTakeHome"],
                "properties": {
                    "email": { "type": "string", "format": "email", "minLength": 5, "maxLength": 255, "example": "user@example.com" },
                    "password": { "type": "string", "format": "password", "minLength": 10, "maxLength": 256, "example": "secretpassword" },
                    "salary": { "type": "number", "minimum": 1, "example": 75000 },
                    "monthlyTakeHome": { "type": "number", "minimum": 1, "example": 4500 }
                }
            }
        }
    }
}
