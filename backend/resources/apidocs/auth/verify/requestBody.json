{
    "required": true,
    "content": {
        "application/x-www-form-urlencoded": {
            "schema": {
                "type": "object",
                "required": ["email", "password", "verificationCode"],
                "properties": {
                    "email": { "type": "string", "format": "email", "example": "test1@gmail.com" },
                    "password": { "type": "string", "format": "password", "example": "secretpassword" },
                    "verificationCode": { "type": "string", "minLength": 8, "maxLength": 8, "example": "AB3CD4EF" }
                }
            }
        }
    }
}
