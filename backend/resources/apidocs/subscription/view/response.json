{
    "description": "Paginated subscriptions. Active subscriptions are listed first.",
    "content": {
        "application/json": {
            "schema": {
                "type": "object",
                "properties": {
                    "error": { "type": "boolean", "example": false },
                    "data": {
                        "type": "object",
                        "properties": {
                            "subscriptions": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "id": { "type": "integer", "example": 7 },
                                        "nextChargeDate": { "type": "string", "format": "date", "example": "2025-04-15" },
                                        "amount": { "type": "number", "example": 14.99 },
                                        "description": { "type": "string", "example": "Netflix" },
                                        "category": {
                                            "type": "string",
                                            "description": "Category name.",
                                            "example": "Streaming"
                                        },
                                        "interval": { "type": "string", "enum": ["M", "Y"], "example": "M" },
                                        "active": { "type": "integer", "enum": [0, 1] }
                                    }
                                }
                            },
                            "filteredSum": {
                                "type": "number",
                                "description": "Sum of amounts matching the search and interval.",
                                "example": 14.99
                            },
                            "totalSum": {
                                "type": "number",
                                "description": "Sum of all subscription amounts.",
                                "example": 64.97
                            }
                        }
                    },
                    "pagination": {
                        "type": "object",
                        "properties": {
                            "page": { "type": "integer", "example": 1 },
                            "offset": { "type": "integer", "example": 0 },
                            "totalRecords": {
                                "type": "integer",
                                "description": "Total records before search filtering.",
                                "example": 42
                            },
                            "filteredRecords": {
                                "type": "integer",
                                "description": "Records matching the search.",
                                "example": 42
                            },
                            "maxRows": { "type": "integer", "description": "Always 0 - not computed.", "example": 0 },
                            "totalPages": {
                                "type": "integer",
                                "description": "Always 1 - not computed. Use filteredRecords / records instead.",
                                "example": 1
                            }
                        }
                    }
                }
            }
        }
    }
}
