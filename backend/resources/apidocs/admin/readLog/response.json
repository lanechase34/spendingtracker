{
    "description": "Tail of the log file.",
    "content": {
        "application/json": {
            "schema": {
                "type": "object",
                "properties": {
                    "error": { "type": "boolean", "example": false },
                    "data": {
                        "type": "object",
                        "properties": {
                            "filename": { "type": "string", "example": "app.log" },
                            "lines": { "type": "array", "items": {"type": "string"} },
                            "count": { "type": "integer", "description": "Lines returned." },
                            "total": { "type": "integer", "description": "Matching lines in the file." },
                            "truncated": { "type": "boolean", "description": "true when total > count." },
                            "filtered": { "type": "boolean", "description": "true when search was used." }
                        }
                    }
                }
            }
        }
    }
}
