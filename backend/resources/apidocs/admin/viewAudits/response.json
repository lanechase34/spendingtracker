{
    "description": "Paginated audit records.",
    "content": {
        "application/json": {
            "schema": {
                "type": "object",
                "properties": {
                    "error": { "type": "boolean", "example": false },
                    "data": {
                        "type": "object",
                        "properties": {
                            "audits": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "id": { "type": "integer" },
                                        "created": { "type": "string", "example": "2025-04-15 14:20:57" },
                                        "ip": { "type": "string" },
                                        "urlpath": { "type": "string" },
                                        "method": { "type": "string" },
                                        "agent": { "type": "string" },
                                        "detail": { "type": "string" },
                                        "statuscode": { "type": "integer" },
                                        "delta": { "type": "integer", "description": "Response time in ms." },
                                        "email": { "type": "string", "nullable": true }
                                    }
                                }
                            }
                        }
                    },
                    "pagination": {
                        "type": "object",
                        "properties": {
                            "page": { "type": "integer", "example": 1 },
                            "offset": { "type": "integer", "example": 0 },
                            "totalRecords": {
                                "type": "integer",
                                "description": "Records in the date range before search filtering. Cached per date range, so it can lag behind new records and read lower than filteredRecords.",
                                "example": 42
                            },
                            "filteredRecords": {
                                "type": "integer",
                                "description": "Records matching the search.",
                                "example": 42
                            },
                            "maxRows": { "type": "integer", "description": "Always 0 - not computed.", "example": 0 },
                            "totalPages": {
                                "type": "integer",
                                "description": "Always 1 - not computed. Use filteredRecords / records instead.",
                                "example": 1
                            }
                        }
                    }
                }
            }
        }
    }
}
