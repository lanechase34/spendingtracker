# Env
ENVIRONMENT=development

# Lucee Admin (local/test only - omit in production), Guard, Image Extensions
OTHER_EXTENSIONS=,CED6227E-0F49-6367-A68D21AACA6B07E8;version=1.0.0.9,37C61C0A-5D7E-4256-8572639BE0CF5838;version=3.1.0.7,B737ABC4-D43F-4D91-8E8E973E37C40D1B;version=3.1.0.11

# Config
CFCONFIG_ADMINPASSWORD=
LUCEE_ADMIN_ENABLED=false
INSPECTTEMPLATE=
IMAGEMAGICKPATH=

# Web
HTTP_HOST=127.0.0.1
HTTP_PORT=8082
REQUESTTIMEOUT=120

# Java
OS=
JAVAHEAP=1024

# Database
DB_GRAMMAR=PostgresGrammar@qb
DB_SCHEMA=public
DB_DATABASE=
DB_BUNDLENAME=org.postgresql.jdbc
DB_BUNDLEVERSION=42.7.11
DB_CLASS=org.postgresql.Driver
DB_DRIVER=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=

# Email
EMAIL_SERVER=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_TLS=false
EMAIL_SSL=false
EMAIL_SPOOL=false

# Secrets
REINITKEY=
JWT_SECRET=
# Generate with: generateSecretKey(algorithm="AES", keysize=256)
ENCRYPTIONKEY=